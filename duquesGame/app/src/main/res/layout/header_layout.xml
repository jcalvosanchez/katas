<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/silver_charro"
    android:padding="16dp"
    android:layout_alignParentTop="true">

    <TextView
        android:id="@+id/game_tile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/juego_del_duque"
        android:textColor="@color/dark_neutral"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/helpButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@null"
        android:contentDescription="@string/ver_reglas_del_juego"
        android:onClick="showRules"
        android:src="@drawable/baseline_live_help_24" />

</LinearLayout>
